# 1. Загрузить функции
source("R/profile_developers.R")

# 2. Подключиться к БД
con <- DBI::dbConnect(duckdb::duckdb(), "git_data.duckdb")

# 3. Поиск разработчика
developers <- search_developers(con, "jeff")
print(developers)

# 4. Полный профиль по email
profile <- get_developer_profile_by_email(con, email = "jeff@joedog.org")
print(profile)

# 5. Просмотр различных аспектов профиля
print(profile$basic_stats)          # базовая статистика
print(profile$hourly_distribution)   # распределение по часам
print(profile$weekday_patterns)      # активность по дням
print(profile$commit_size)           # размер коммитов
print(profile$languages)             # предпочитаемые языки
print(profile$stability)             # стабильность кода
print(profile$sensitive_files)       # чувствительные файлы

# 6. Экспорт профиля в CSV
export_profile_to_csv(profile, "my_profiles")

# 7. Получить сводную статистику по всем
summary <- get_summary_stats(con)
print(summary$overview)
print(summary$top_5_developers)

# 8. Анализ аномалий
anomalies <- get_anomaly_detection(con)
print(anomalies)

# Закрыть соединение
DBI::dbDisconnect(con, shutdown = TRUE)